<Window
    x:Class="CSharpRisohEditor.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Click="NewFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open..." Click="OpenFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save..." Click="SaveFile_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="{x:Bind Close}"/>
            </MenuBarItem>
            <MenuBarItem Title="Add">
                <MenuFlyoutItem Text="Dialog..." Click="AddDialog_Click"/>
                <MenuFlyoutItem Text="Menu..." Click="AddMenu_Click"/>
                <MenuFlyoutItem Text="String Table..." Click="AddStringTable_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Resource List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="Resources" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,0,0,8"/>

                <ListView x:Name="ResourceListView" 
                         Grid.Row="1"
                         SelectionMode="Single"
                         SelectionChanged="ResourceListView_SelectionChanged"
                         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                         BorderThickness="1"
                         CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Padding="4">
                                <TextBlock Text="{Binding Type}" 
                                          FontWeight="SemiBold" 
                                          Margin="0,0,8,0"/>
                                <TextBlock Text="-" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           Spacing="4" 
                           Margin="0,8,0,0">
                    <Button Content="Add Dialog" Click="AddDialog_Click"/>
                    <Button Content="Delete" Click="DeleteResource_Click"/>
                </StackPanel>
            </Grid>

            <!-- Splitter -->
            <Border Grid.Column="1" 
                   Width="1" 
                   Background="{ThemeResource CardStrokeColorDefaultBrush}" 
                   Margin="8,0"/>

            <!-- Resource Details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                          Text="Resource Details" 
                          FontSize="16" 
                          FontWeight="SemiBold" 
                          Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                    <TextBox x:Name="ResourceDetailsTextBox"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            BorderThickness="0"
                            Padding="8"
                            FontFamily="Consolas"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" 
             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
             BorderThickness="0,1,0,0"
             Padding="8,4">
            <TextBlock x:Name="StatusBarText" 
                      Text="Ready" 
                      VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
